rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }
    function ownsData(data) {
      return isAuthenticated() && (
        data.userId == request.auth.uid ||
        data.user_id == request.auth.uid
      );
    }
    function isValidExpense(data) {
      return data.keys().hasAll([
          'category',
          'amount',
          'description',
          'date',
          'month',
          'year'
        ])
        && (
          data.keys().hasAny(['userId']) ||
          data.keys().hasAny(['user_id'])
        )
        && (
          data.userId == request.auth.uid ||
          data.user_id == request.auth.uid
        )
        && data.category is string
        && data.category.size() > 0
        && data.amount is number
        && data.amount > 0
        && data.description is string
        && data.date is timestamp
        && data.month is number
        && data.month >= 1
        && data.month <= 12
        && data.year is number
        && data.year >= 2020
        && data.year <= 2035;
    }
    function isValidIncome(data) {
      return data.keys().hasAll([
          'type',
          'amount',
          'note',
          'date',
          'month',
          'year'
        ])
        && (
          data.keys().hasAny(['userId']) ||
          data.keys().hasAny(['user_id'])
        )
        && (
          data.userId == request.auth.uid ||
          data.user_id == request.auth.uid
        )
        && data.type is string
        && data.type.size() > 0
        && data.amount is number
        && data.amount >= 0
        && data.note is string
        && data.date is timestamp
        && data.month is number
        && data.month >= 1
        && data.month <= 12
        && data.year is number
        && data.year >= 2020
        && data.year <= 2035;
    }
    function isValidNote(data) {
      return data.keys().hasAll([
          'title',
          'content',
          'userId',
          'hasNotification',
          'isRecurring',
          'isNote',
          'createdAt',
          'updatedAt'
        ])
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 200
        && data.content is string
        && data.content.size() <= 5000
        && data.userId == request.auth.uid
        && data.hasNotification is bool
        && data.isRecurring is bool
        && data.isNote is bool
        && (
          !data.hasNotification ||
          data.notificationDate is timestamp
        )
        && (
          !data.isRecurring ||
          data.recurringDays is list
        )
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }
    function isValidTask(data) {
      return data.keys().hasAll([
          'title',
          'note',
          'repeat',
          'weekdays',
          'startAt',
          'remind',
          'doneDays'
        ])
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 200
        && data.note is string
        && data.note.size() <= 5000
        && data.repeat in ['none', 'daily', 'weekly', 'monthly']
        && data.weekdays is list
        && data.weekdays.size() <= 7
        && data.startAt is timestamp
        && data.remind is bool
        && data.doneDays is list
        && data.doneDays.size() <= 400
        && (!('endDate' in data) || data.endDate == null || data.endDate is timestamp)
        && (!('completedAt' in data) || data.completedAt == null || data.completedAt is timestamp);
    }
    match /expenses/{expenseId} {
      allow read: if ownsData(resource.data);
      allow create: if isValidExpense(request.resource.data);
      allow update: if ownsData(resource.data) && isValidExpense(request.resource.data);
      allow delete: if ownsData(resource.data);
    }
    match /incomes/{incomeId} {
      allow read: if ownsData(resource.data);
      allow create: if isValidIncome(request.resource.data);
      allow update: if ownsData(resource.data) && isValidIncome(request.resource.data);
      allow delete: if ownsData(resource.data);
    }
    match /notes/{noteId} {
      allow read: if ownsData(resource.data);
      allow create: if isValidNote(request.resource.data);
      allow update: if ownsData(resource.data) && isValidNote(request.resource.data);
      allow delete: if ownsData(resource.data);
    }
    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
      match /tasks/{taskId} {
        allow read, delete: if isAuthenticated() && request.auth.uid == userId;
        allow create, update: if isAuthenticated()
          && request.auth.uid == userId
          && isValidTask(request.resource.data);
      }
      match /access_logs/{logId} {
        allow create, read: if isAuthenticated() && request.auth.uid == userId;
        allow update, delete: if false;
      }
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}